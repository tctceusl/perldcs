---RoundRobin---

#include <stdio.h>

int main() {
    int n = 4, quantum = 2;
    char *name[] = {"P1", "P2", "P3", "P4"};
    int at[] = {0, 1, 2, 3};
    int bt[] = {10, 5, 8, 6};
    int rem[4], ct[4], tat[4], wt[4];

    for (int i = 0; i < n; i++)
        rem[i] = bt[i];

    int time = 0, completed = 0;

    printf("--- Round Robin Scheduling (Quantum = %d) ---\n", quantum);
    printf("Execution Sequence:\n");

    while (completed < n) {
        int done = 1;
        for (int i = 0; i < n; i++) {
            if (rem[i] > 0 && at[i] <= time) {
                int t = 0;
                if(rem[i] < quantum){
                    t = rem[i];
                }else{
                    t = quantum;
                }
                printf("[t=%2d - t=%2d] %s\n", time, time + t, name[i]);
                time += t;
                rem[i] -= t;
                if (rem[i] == 0) {
                    ct[i] = time;
                    completed++;
                }
                done = 0;
            }
        }
        if (done) time++;
    }

    float totalTAT = 0, totalWT = 0;
    printf("\n\n--------------------------\n");
    printf("Process\tAT\tBT\tCT\tTAT\tWT\n");
    printf("--------------------------\n");
    for (int i = 0; i < n; i++) {
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i] - bt[i];
        totalTAT += tat[i];
        totalWT += wt[i];
        printf("%s\t\t%d\t%d\t%d\t%d\t%d\n", name[i], at[i], bt[i], ct[i], tat[i], wt[i]);
        
    }
    printf("--------------------------\n");

    printf("\nAverage TAT = %.2f\n", totalTAT / n);
    printf("Average WT  = %.2f\n", totalWT / n);

    return 0;
}

---Banker's---

#include <stdio.h>

#define MAX 10

int main() {
    int n, m; 
    int alloc[MAX][MAX], max[MAX][MAX], need[MAX][MAX];
    int avail[MAX];
    int finish[MAX] = {0};
    int safeSeq[MAX];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter number of resources: ");
    scanf("%d", &m);

    
    printf("\nEnter Allocation Matrix:\n");
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < m; j++) {
            scanf("%d", &alloc[i][j]);
        }
    }

    
    printf("\nEnter Max Matrix:\n");
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < m; j++) {
            scanf("%d", &max[i][j]);
        }
    }

    
    printf("\nEnter Available Resources:\n");
    for(int i = 0; i < m; i++) {
        scanf("%d", &avail[i]);
    }

    for(int i = 0; i < n; i++) {
        for(int j = 0; j < m; j++) {
            need[i][j] = max[i][j] - alloc[i][j];
        }
    }

    int count = 0;

    while(count < n) {
        int found = 0;

        for(int i = 0; i < n; i++) {
            if(finish[i] == 0) {
                int j;
                for(j = 0; j < m; j++) {
                    if(need[i][j] > avail[j]) {
                        break;
                    }
                }

                
                if(j == m) {
                    for(int k = 0; k < m; k++) {
                        avail[k] += alloc[i][k];
                    }

                    safeSeq[count++] = i;
                    finish[i] = 1;
                    found = 1;
                }
            }
        }

       
        if(found == 0) {
            printf("\nSystem is NOT in safe state!\n");
            return 0;
        }
    }

   
    printf("\nSystem is in SAFE state.\nSafe sequence: ");
    for(int i = 0; i < n; i++) {
        printf("P%d ", safeSeq[i]);
    }

    printf("\n");
    return 0;
}
