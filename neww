#include <iostream>
#include <string>
#include <cctype>
using namespace std;

// Count vowels
int countVowels(string str){
    int count = 0;
    for(int i = 0; i < str.length(); i++){
        char ch = tolower(str[i]);
        if(ch=='a' || ch=='e' || ch=='i' || ch=='o' || ch=='u'){
            count++;
        }
    }
    return count;
}

// Count words
int countWords(string str){
    int count = 0;
    for(int i = 0; i < str.length(); i++){
        if(str[i] == ' '){
            count++;
        }
    }
    return count + 1; // words = spaces + 1
}

// Check palindrome
bool isPalindrome(string str){
    int start = 0;
    int end = str.length() - 1;

    while(start < end){
        if(str[start] != str[end]){
            return false;
        }
        start++;
        end--;
    }
    return true;
}








//////////////////fact + Fibo ////////////////




#include <iostream>
using namespace std;

// Function to calculate factorial
int factorial(int n) {
    int fact = 1;
    for(int i = 1; i <= n; i++) {
        fact *= i;
    }
    return fact;
}

// Function to calculate fibonacci
int fibonacci(int n) {
    if(n == 0) return 0;
    if(n == 1) return 1;

    int a = 0, b = 1, c;
    for(int i = 2; i <= n; i++) {
        c = a + b;
        a = b;
        b = c;
    }
    return b;
}

int main() {
    int num;

    cout << "Enter a number: ";
    cin >> num;

    cout << "Factorial of " << num << " = " << factorial(num) << endl;
    cout << "Fibonacci of " << num << " = " << fibonacci(num) << endl;

    return 0;
}





////////////seat book //////////////


#include <iostream>
#include <cctype>
using namespace std;

int main () {

    const int Row = 13;
    const int Col = 6;

    char ticket_type;
    int row;
    char col;
    char seats[Row][Col];

    // Initialize seats
    for(int i=0;i<Row;i++) {
        for(int j=0;j<Col;j++) {
            seats[i][j] = '*';
        }
    }

    cout << "Row 1 and 2 are First Class (F)\n";
    cout << "Row 3 to 7 are Business Class (B)\n";
    cout << "Row 8 to 13 are Economy Class (E)\n\n";

    cout << "* - Available\n";
    cout << "x - Occupied\n\n";

    cout << "        A   B   C   D   E   F\n";

    for(int i=0;i<Row;i++) {
        cout << "Row " << i+1 << "   ";
        for(int j=0;j<Col;j++) {
            cout << seats[i][j] << "   ";
        }
        cout << endl;
    }

    cout << "\nEnter Ticket type (F/B/E): ";
    cin >> ticket_type;

    cout << "Enter Row (1-13): ";
    cin >> row;

    cout << "Enter Column (A-F): ";
    cin >> col;

    col = toupper(col);   // ?? important fix

    bool valid = false;

    if(ticket_type == 'F' && row>=1 && row<=2) valid = true;
    else if(ticket_type == 'B' && row>=3 && row<=7) valid = true;
    else if(ticket_type == 'E' && row>=8 && row<=13) valid = true;

    if(col < 'A' || col > 'F'){
        cout << "Invalid column!" << endl;
        return 0;
    }

    if(!valid){
        cout << "Invalid seat selection!" << endl;
        return 0;
    }

    int colindex = col - 'A';

    if(seats[row-1][colindex] == 'x'){
        cout << "Seat already occupied!" << endl;
    }
    else{
        seats[row-1][colindex] = 'x';
        cout << "Seat booked successfully!" << endl;
    }

    cout << "\n----- Updated Seat Map -----\n";
    cout << "        A   B   C   D   E   F\n";

    for(int i=0;i<Row;i++) {
        cout << "Row " << i+1 << "   ";
        for(int j=0;j<Col;j++) {
            cout << seats[i][j] << "   ";
        }
        cout << endl;
    }

    return 0;
}


