#include <iostream>
#include <iomanip>
using namespace std;

double calculateAverage(double prices[], int size) {
    double sum = 0;
    for (int i = 0; i < size; i++) {
        sum += prices[i];
    }
    return sum / size;
}

void findHighest(double prices[], int size, string days[]) {
    double max = prices[0];
    int index = 0;

    for (int i = 1; i < size; i++) {
        if (prices[i] > max) {
            max = prices[i];
            index = i;
        }
    }

    cout << "Highest price = " << max << " (" << days[index] << ")" << endl;
}

void findLowest(double prices[], int size, string days[]) {
    double min = prices[0];
    int index = 0;

    for (int i = 1; i < size; i++) {
        if (prices[i] < min) {
            min = prices[i];
            index = i;
        }
    }

    cout << "Lowest price = " << min << " (" << days[index] << ")" << endl;
}

int countAboveAverage(double prices[], int size, double avg) {
    int count = 0;
    for (int i = 0; i < size; i++) {
        if (prices[i] > avg) {
            count++;
        }
    }
    return count;
}

int main() {
    const int SIZE = 7;
    double prices[SIZE];
    string days[SIZE] = {"Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"};

    cout << "Enter fish prices for 7 days:\n";
    for (int i = 0; i < SIZE; i++) {
        cout << days[i] << ": ";
        cin >> prices[i];
    }

    double avg = calculateAverage(prices, SIZE);

    cout << fixed << setprecision(2);
    cout << "\nAverage price = " << avg << endl;

    findHighest(prices, SIZE, days);
    findLowest(prices, SIZE, days);

    int aboveAvg = countAboveAverage(prices, SIZE, avg);
    cout << "Days above average = " << aboveAvg << endl;

    return 0;
}

















