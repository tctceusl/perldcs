<?php
if (isset($_POST["submit"])) {

    $nic = $_POST["nic"];

    if (strlen($nic) == 10) {
        $year = "19" . substr($nic, 0, 2);
        $days = substr($nic, 2, 3);
    }
    elseif (strlen($nic) == 12) {
        $year = substr($nic, 0, 4);
        $days = substr($nic, 4, 3);
    }
    else {
        echo "<p style='color:red;'>Invalid NIC</p>";
        exit;
    }

    if ($days > 500) {
        $gender = "Female";
        $days -= 500;
    } else {
        $gender = "Male";
    }

    $months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
    $days_in_month = [31,29,31,30,31,30,31,31,30,31,30,31];

    $i = 0;
    while ($days > $days_in_month[$i]) {
        $days -= $days_in_month[$i];
        $i++;
    }

    $month = $months[$i];
    $day = $days;

    echo "<div class='result'>";
    echo "Gender: $gender <br>";
    echo "DOB: $day $month $year";
    echo "</div>";
}
?>

</div>

</body>
</html>

