#include <iostream>
using namespace std;

int LEN(char STR[]) {
    int i = 0;
    while (STR[i] != '\0') i++;
    return i;
}

void SUBSTRING(char STR[], int start, int end, char result[]) {
    int k = 0;
    for (int i = start; i <= end && STR[i] != '\0'; i++) {
        result[k++] = STR[i];
    }
    result[k] = '\0';
}

bool isAlphabet(char STR[]) {
    for (int i = 0; STR[i] != '\0'; i++) {
        if (!((STR[i] >= 'A' && STR[i] <= 'Z') || (STR[i] >= 'a' && STR[i] <= 'z')))
            return false;
    }
    return true;
}

int TextToValue(char STR[]) {
    int value = 0;
    for (int i = 0; STR[i] != '\0'; i++) {
        if (STR[i] < '0' || STR[i] > '9') return -1;
        value = value * 10 + (STR[i] - '0');
    }
    return value;
}

void toUpperCase(char STR[]) {
    for (int i = 0; STR[i] != '\0'; i++) {
        if (STR[i] >= 'a' && STR[i] <= 'z') {
            STR[i] = STR[i] - 32;
        }
    }
}

int main() {
    char input[100];
    char parts[6][20];
    int partIndex = 0, start = 0, k = 0;

    cout << "Please enter the registration number: ";
    cin.getline(input, 100);

    for (int i = 0; ; i++) {
        if (input[i] == '/' || input[i] == '\0') {
            SUBSTRING(input, start, i - 1, parts[partIndex]);
            partIndex++;
            start = i + 1;
        }
        if (input[i] == '\0') break;
    }

    if (partIndex != 6) {
        cout << "Error: Invalid format." << endl;
        cout << "Status : Invalid";
