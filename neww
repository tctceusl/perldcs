#include <iostream>
using namespace std;

int main() {
    int n;


    while (true) {
        cout << "Enter a positive odd integer (>= 3): ";
        cin >> n;

        if (n >= 3 && n % 2 != 0) {
            break; 
        } else {
            cout << "Invalid input! Try again.\n";
        }
    }

    int mid = n / 2;


    for (int i = 0; i <= mid; i++) {
     
        for (int j = 0; j < mid - i; j++) {
            cout << " ";
        }

      
        for (int j = 0; j < 2 * i + 1; j++) {
            cout << "*";
        }

        cout << endl;
    }


    for (int i = mid - 1; i >= 0; i--) {
       
        for (int j = 0; j < mid - i; j++) {
            cout << " ";
        }

    
        for (int j = 0; j < 2 * i + 1; j++) {
            cout << "*";
        }

        cout << endl;
    }

    return 0;
}










