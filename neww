<!DOCTYPE html>
<html>
<head>
    <title>Roman to Decimal</title>
</head>
<body>

<h2>Roman to Decimal</h2>

<form method="post">
    Enter Roman:
    <input type="text" name="roman" required>
    <input type="submit" name="submit" value="Convert">
</form>

<?php


function val($r) {
    switch($r){
        case "I": return 1;
        case "V": return 5;
        case "X": return 10;
        case "L": return 50;
        case "C": return 100;
        case "D": return 500;
        case "M": return 1000;
        default: return 0;
    }
}

if (isset($_POST["submit"])) {

    $roman = strtoupper(trim($_POST["roman"])); 

  
    if (empty($roman)) {
        echo "<p style='color:red;'>Please enter a value</p>";
    }
    
    elseif (!preg_match("/^[IVXLCDM]+$/", $roman)) {
        echo "<p style='color:red;'>Invalid Roman Number</p>";
    } 
    else {

        $total = val($roman[0]);

        for ($i = 1; $i < strlen($roman); $i++) {

            $current = val($roman[$i]);
            $prev = val($roman[$i - 1]);

            $total += $current;

            if ($current > $prev) {
                $total -= (2 * $prev);
            }
        }

        echo "<h3>Answer: $total</h3>";
    }
}
?>

</body>
</html>

